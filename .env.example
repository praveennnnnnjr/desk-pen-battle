# Copy to .env and fill in from Firebase console → Project settings → Your apps → Web app.
# Leave these empty to run in DEMO MODE (on-device accounts, Pass & Play only).
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Must match the region in functions/index.js
EXPO_PUBLIC_FIREBASE_FUNCTIONS_REGION=asia-south1

# Set to "off" to skip the Cloud Function and always use the built-in question bank
EXPO_PUBLIC_AI_QUESTIONS=on
